# ==============================================================================
# GREENSCAPE PRO PROPOSAL INTELLIGENCE AGENT - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for development.
# NEVER commit secret values or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: Port on which the Express server listens.
# Required: YES (Defaults to 3000 in code)
# Configured in: Container runtime, Cloud Run settings, or .env.local
PORT=3000

# NODE_ENV: Node execution mode ('development' | 'test' | 'production')
# Required: YES
# Configured in: CI/CD, Container Dockerfile, or Cloud Run environment
NODE_ENV=development


# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Server-Side Only)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key used for field note extraction & narrative synthesis.
# Required: YES (In production; system falls back to heuristic parser in dev if missing)
# Where to configure: Google Cloud Secret Manager or AI Studio Settings (process.env.GEMINI_API_KEY)
GEMINI_API_KEY=


# ------------------------------------------------------------------------------
# 3. DATABASE / SUPABASE POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
# SUPABASE_URL: URL endpoint of the hosted Supabase PostgreSQL instance.
# Required: OPTIONAL (Defaults to indexed in-memory database store if unconfigured)
# Configured in: Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=

# SUPABASE_ANON_KEY: Public anonymous key for client/edge auth if applicable.
# Required: OPTIONAL
# Configured in: Supabase Project Dashboard -> Settings -> API
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Privileged backend service role key for migrations & CRUD.
# Required: OPTIONAL (Required when connecting backend directly to Supabase)
# Configured in: Supabase Project Dashboard -> Settings -> API -> Secret Service Role
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS (CRITICAL OUTBOX)
# ------------------------------------------------------------------------------
# SLACK_WEBHOOK_URL: Incoming Webhook URL for alerting the installation crew upon proposal approval.
# Required: OPTIONAL (Non-blocking: approvals succeed and log audit entries even if webhook is unconfigured)
# Configured in: Slack App Directory -> Incoming Webhooks -> Channel #proposals-approved
SLACK_WEBHOOK_URL=

# GHL_API_KEY: GoHighLevel CRM OAuth Bearer Token or Location API Key.
# Required: OPTIONAL (Non-blocking: updates CRM deal stage to 'Proposal Approved')
# Configured in: GoHighLevel Settings -> Company / Developers -> API Keys
GHL_API_KEY=

# GHL_WEBHOOK_URL: Custom GoHighLevel Webhook Workflow endpoint for lead pipeline automation.
# Required: OPTIONAL
# Configured in: GoHighLevel Automations -> Workflow Webhook Trigger
GHL_WEBHOOK_URL=
